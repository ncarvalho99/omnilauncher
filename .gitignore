/.lingma/
/.omp/
/.pi/
/.qoder/
/.rovodev/
/.shai/
/.tabnine/
/.trae/
/.vibe/
/.zcode/

# Dynamic cross-chat checkpoints are local evidence, never repository policy.
/prompt_handoff_*.md

# The maintained documentation, its changelog and the working audits are kept
# beside the checkout rather than published. AGENTS.md still routes through them
# and they still have to be written; they are simply not part of what ships.
/docs/

