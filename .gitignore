# Keep the local ulaunch checkout out of this repository.
/ulaunch/

# Local reference builds kept side by side for comparison, and saved CI logs.
/.compilado_autor/
/.compilado_fork/
/.logs/

# Manually fetched toolchain packages, kept out of the tree.
/.download/

# Staging area for assets and ideas waiting to be implemented. What gets
# implemented is committed from wherever it belongs in the tree; this folder
# itself never is.
/.features/
/.shared/

# Install layout and packaged zip produced by .logs/build-local.ps1, the same
# two the CI workflow builds and uploads as artifacts.
/dist/
/artifacts/

# The authenticated admin surface of the metadata service. The rest of web/ is
# published on purpose; this one stays out of the public repository. Its safety
# does not depend on being hidden -- it is Argon2id, server-side sessions and
# CSRF -- and it holds no credentials, which live only on the server. Keeping it
# private simply gives an attacker nothing to read.
/web/metacritic-proxy/admin_panel.py

# Regenerated frame sources and Python bytecode used while authoring animated
# theme assets. The committed DDS frames live under romfs/themes instead.
/fps/
/romfs/icons-regenerated/
tools/__pycache__/
__pycache__/

# Local hbloader experiments; the project does not consume these binaries.
/lib/switchu-hbloader/

# ffmpeg local binary
/ffmpeg/

# Credentials and local service state. Keep examples in source, never real
# values, private keys, credential stores, or production/local databases.
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.kdbx
*.keystore
id_rsa
id_ed25519
**/.secrets/
**/secrets/
**/credentials/
*.db
*.sqlite
*.sqlite3

# Local tool state can contain permissions, session data, and credentials, and
# the working notes an agent keeps are evidence for the person running it rather
# than anything a reader of this repository needs. None of it is published.
/.claude/
/.codex/
/.cursor/
/.windsurf/
/.gemini/
/.aider*
/.continue/
/.roo/
/.kilocode/
/.junie/
/.github/copilot-instructions.md
/.cursorrules
/.windsurfrules
/.clinerules
/AGENTS.local.md
/.agents/
/.opencode/
/.antigravity/
/.github/skills/

# GitHub Spec Kit (.specify/) and the ~30 generated Spec Master per-project
# agent adapters it and spec-master/lib/adapters_gen.py write, one directory
# per supported agent (Claude/Copilot/Codex/Qwen keep their bespoke, already
# ignored .claude/.github/.codex/.qwen paths above instead). Machine-local
# tool state, not published.
/.specify/
/specs/
# Spec Master's own run state (discovery, normalized context, feature
# registry, workflow state) and the ad hoc per-fix context files fed into it.
# Machine-local evidence for the person running it, not repository policy.
/.spec-master/
/context-*.md
/.alquimia/
/.augment/
/.bob/
/.codebuddy/
